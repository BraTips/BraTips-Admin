{
  "rewrites": [
    {
      "source": "/BraTipsters/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/BraTipsters/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
